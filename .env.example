# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# Server
PORT=3000
NODE_ENV=production

# CORS — domini del tuo sito, separati da virgola
ALLOWED_ORIGINS=https://tuosito.com,https://www.tuosito.com

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Widget token — stringa segreta che il widget manda come X-Widget-Token.
# Se non impostata il check è disabilitato (backwards compat).
# Genera con: openssl rand -hex 32
WIDGET_SECRET=

# Redis (opzionale) — se impostato, il throttler usa Redis invece della memoria
# e la semantic cache persiste su Redis invece che su data/cache.json.
# Formato: redis://[:password@]host[:port][/db]
# In Docker: impostato automaticamente da docker-compose.yml
REDIS_URL=
